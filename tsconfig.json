{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/lib/*": [
        "./lib/*"
      ],
      "@/data/*": [
        "./data/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-wuxia-bg-dev/types/**/*.ts",
    ".next-wuxia-dev/types/**/*.ts",
    ".next-wuxia-no-corner/types/**/*.ts",
    ".next-wuxia-prod/types/**/*.ts",
    ".next-wuxia-site-dev/types/**/*.ts",
    ".next-wuxia-site-final/types/**/*.ts",
    ".next-wuxia-site-final2/types/**/*.ts",
    ".next-wuxia-site/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-wuxia-atmosphere/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
